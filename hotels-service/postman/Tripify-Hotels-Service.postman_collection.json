        {
          "name": "Get Hotel By Id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "",
                  "    pm.test('hotelId matches', function () {",
                  "        pm.expect(body.hotelId).to.eql(pm.collectionVariables.get('hotelId'));",
                  "    });",
                  "",
                  "    pm.test('price is total for stay', function () {",
                  "        pm.expect(body.price).to.be.a('number');",
                  "        pm.expect(body.price).to.be.above(0);",
                  "    });",
                  "",
                  "    pm.test('photos is array', function () {",
                  "        pm.expect(body.photos).to.be.an('array');",
                  "    });",
                  "",
                  "    pm.test('tags is array (ML)', function () {",
                  "        pm.expect(body.tags).to.be.an('array');",
                  "    });",
                  "",
                  "    pm.test('rooms is array', function () {",
                  "        pm.expect(body.rooms).to.be.an('array');",
                  "    });",
                  "",
                  "    if (body.rooms && body.rooms.length > 0) {",
                  "        const room = body.rooms[0];",
                  "",
                  "        pm.test('Room has no providerRoomId', function () {",
                  "            pm.expect(room).to.not.have.property('providerRoomId');",
                  "        });",
                  "",
                  "        pm.test('Room has roomId, name, roomType', function () {",
                  "            pm.expect(room).to.have.property('roomId');",
                  "            pm.expect(room).to.have.property('name');",
                  "            pm.expect(room).to.have.property('roomType');",
                  "        });",
                  "",
                  "        if (room.photos && room.photos.length > 0) {",
                  "            pm.test('Room photo has only url (no photoId/order)', function () {",
                  "                const photo = room.photos[0];",
                  "                pm.expect(photo).to.have.property('url');",
                  "                pm.expect(photo).to.not.have.property('photoId');",
                  "                pm.expect(photo).to.not.have.property('order');",
                  "            });",
                  "        }",
                  "",
                  "        if (room.rates && room.rates.length > 0) {",
                  "            const rate = room.rates[0];",
                  "",
                  "            pm.test('Rate has no providerRateId', function () {",
                  "                pm.expect(rate).to.not.have.property('providerRateId');",
                  "            });",
                  "",
                  "            pm.test('Rate has no loyalty', function () {",
                  "                pm.expect(rate).to.not.have.property('loyalty');",
                  "            });",
                  "",
                  "            pm.test('Rate has rateId, title, pricing', function () {",
                  "                pm.expect(rate).to.have.property('rateId');",
                  "                pm.expect(rate).to.have.property('title');",
                  "                pm.expect(rate).to.have.property('pricing');",
                  "            });",
                  "        }",
                  "",
                  "        console.log('Rooms count:', body.rooms.length,",
                  "            '| First room:', room.name, '(' + room.roomType + ')',",
                  "            '| Rates:', room.rates ? room.rates.length : 0);",
                  "    }",
                  "",
                  "    console.log('Price (total for stay):', body.price, body.currency);",
                  "}"
                ]
              }
            }
          ],

                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Returns HotelDetails', function () {",
                  "        pm.expect(body).to.have.property('hotelId');",
                  "        pm.expect(body).to.have.property('title');",
                  "        pm.expect(body).to.have.property('rooms');",
                  "    });",
                  "    pm.collectionVariables.set('hotelId', body.hotelId);",
                  "    console.log('Saved hotelId from search:', body.hotelId);",
                  "}"

  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Get Hotel Filters",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Has filters array', function () {",
                  "        pm.expect(body).to.have.property('filters');",
                  "        pm.expect(body.filters).to.be.an('array');",
                  "    });",
                  "    if (body.filters && body.filters.length > 0) {",
                  "        console.log('Available filters:', body.filters.map(f => f.id + ' (' + f.count + ')').join(', '));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Anonymous-Id",
                "value": "{{xAnonymousId}}"
              },
              {
                "key": "X-Generation-Id",
                "value": "{{xGenerationId}}"
              },
              {
                "key": "X-Pack-Revision",
                "value": "{{xPackRevision}}"
              },
              {
                "key": "X-Generation-Mode",
                "value": "{{xGenerationMode}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{xRequestId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels/filters?country={{country}}&city={{city}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "filters"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" }
              ]
            },
            "description": "Каталог фильтров с count > 0 для города. Id из ответа передавай в `filters` при поиске."
          },
          "response": []
        },
        {
          "name": "Get Hotels",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Has hotels array', function () {",
                  "        pm.expect(body).to.have.property('hotels');",
                  "        pm.expect(body.hotels).to.be.an('array');",
                  "    });",
                  "",
                  "    if (body.hotels && body.hotels.length > 0) {",
                  "        const hotel = body.hotels[0];",
                  "        pm.collectionVariables.set('hotelId', hotel.hotelId);",
                  "        pm.test('Hotel has photos array', function () {",
                  "            pm.expect(hotel).to.have.property('photos');",
                  "            pm.expect(hotel.photos).to.be.an('array');",
                  "        });",
                  "        console.log('Saved hotelId:', hotel.hotelId);",
                  "    }",
                  "",
                  "    if (body.nextCursor) {",
                  "        pm.collectionVariables.set('cursor', body.nextCursor);",
                  "        console.log('Saved cursor:', body.nextCursor);",
                  "    } else {",
                  "        pm.collectionVariables.unset('cursor');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Anonymous-Id", "value": "{{xAnonymousId}}" },
              { "key": "X-Generation-Id", "value": "{{xGenerationId}}" },
              { "key": "X-Pack-Revision", "value": "{{xPackRevision}}" },
              { "key": "X-Generation-Mode", "value": "{{xGenerationMode}}" },
              { "key": "X-Request-Id", "value": "{{xRequestId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?country={{country}}&city={{city}}&check_in={{checkIn}}&check_out={{checkOut}}&currency={{currency}}&guests={{guests}}&limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "check_in", "value": "{{checkIn}}" },
                { "key": "check_out", "value": "{{checkOut}}" },
                { "key": "currency", "value": "{{currency}}" },
                { "key": "guests", "value": "{{guests}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "budget", "value": "{{budget}}", "disabled": true }
              ]
            },
            "description": "Список отелей без фильтров. Сохраняет hotelId и nextCursor."
          },
          "response": []
        },
        {
          "name": "Get Hotels (with filters)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Anonymous-Id", "value": "{{xAnonymousId}}" },
              { "key": "X-Generation-Id", "value": "{{xGenerationId}}" },
              { "key": "X-Pack-Revision", "value": "{{xPackRevision}}" },
              { "key": "X-Generation-Mode", "value": "{{xGenerationMode}}" },
              { "key": "X-Request-Id", "value": "{{xRequestId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?country={{country}}&city={{city}}&check_in={{checkIn}}&check_out={{checkOut}}&currency={{currency}}&guests={{guests}}&limit=10&budget=150000&filters=pool&filters=beachfront&filters=rating_8_plus",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "check_in", "value": "{{checkIn}}" },
                { "key": "check_out", "value": "{{checkOut}}" },
                { "key": "currency", "value": "{{currency}}" },
                { "key": "guests", "value": "{{guests}}" },
                { "key": "limit", "value": "10" },
                { "key": "budget", "value": "150000", "description": "Макс. цена в currency" },
                { "key": "filters", "value": "pool" },
                { "key": "filters", "value": "beachfront" },
                { "key": "filters", "value": "rating_8_plus" }
              ]
            },
            "description": "Поиск с filters (AND). Подставь id из Get Hotel Filters. Примеры: wifi, breakfast, pet_friendly, stars_4_plus, stars_5, free_cancellation."
          },
          "response": []
        },
        {
          "name": "Get Hotels (unknown filter → 400)",
          "event": [
            {

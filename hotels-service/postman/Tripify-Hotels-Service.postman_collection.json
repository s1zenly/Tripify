              { "key": "X-Pack-Revision", "value": "{{xPackRevision}}" },
              { "key": "X-Generation-Mode", "value": "{{xGenerationMode}}" },
              { "key": "X-Request-Id", "value": "{{xRequestId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?country={{country}}&city={{city}}&check_in={{checkIn}}&check_out={{checkOut}}&currency={{currency}}&guests={{guests}}&filters=not_in_catalog",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "check_in", "value": "{{checkIn}}" },
                { "key": "check_out", "value": "{{checkOut}}" },
                { "key": "currency", "value": "{{currency}}" },
                { "key": "guests", "value": "{{guests}}" },
                { "key": "filters", "value": "not_in_catalog" }
              ]
            },
            "description": "Негативный сценарий: неизвестный filter id."
          },
          "response": []
        },
        {
          "name": "Get Hotels (next page)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));",
                  "const cursor = pm.collectionVariables.get('cursor');",
                  "if (!cursor) {",
                  "    throw new Error('cursor пустой. Сначала Get Hotels с limit=5 и проверь nextCursor в ответе.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.nextCursor) { pm.collectionVariables.set('cursor', body.nextCursor); }",
                  "    else { pm.collectionVariables.unset('cursor'); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Anonymous-Id", "value": "{{xAnonymousId}}" },
              { "key": "X-Generation-Id", "value": "{{xGenerationId}}" },
              { "key": "X-Pack-Revision", "value": "{{xPackRevision}}" },
              { "key": "X-Generation-Mode", "value": "{{xGenerationMode}}" },
              { "key": "X-Request-Id", "value": "{{xRequestId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?country={{country}}&city={{city}}&check_in={{checkIn}}&check_out={{checkOut}}&currency={{currency}}&guests={{guests}}&limit=5&cursor={{cursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "check_in", "value": "{{checkIn}}" },
                { "key": "check_out", "value": "{{checkOut}}" },
                { "key": "currency", "value": "{{currency}}" },
                { "key": "guests", "value": "{{guests}}" },
                { "key": "limit", "value": "5" },
                { "key": "cursor", "value": "{{cursor}}" }
              ]
            },
            "description": "Пагинация по nextCursor."
          },
          "response": []
        },
        {
          "name": "Get Hotel By Id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('xRequestId', 'req-' + pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('hotelId matches', function () {",
                  "        pm.expect(body.hotelId).to.eql(pm.collectionVariables.get('hotelId'));",
                  "    });",
                  "    pm.test('photos is array', function () {",
                  "        pm.expect(body.photos).to.be.an('array');",
                  "    });",
                  "    pm.test('tags is array (ML)', function () {",
                  "        pm.expect(body.tags).to.be.an('array');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Anonymous-Id", "value": "{{xAnonymousId}}" },
              { "key": "X-Generation-Id", "value": "{{xGenerationId}}" },
              { "key": "X-Pack-Revision", "value": "{{xPackRevision}}" },
              { "key": "X-Generation-Mode", "value": "{{xGenerationMode}}" },
              { "key": "X-Request-Id", "value": "{{xRequestId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels/{{hotelId}}?country={{country}}&city={{city}}&check_in={{checkIn}}&check_out={{checkOut}}&guests={{guests}}&currency={{currency}}&budget=150000",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "{{hotelId}}"],
              "query": [
                { "key": "country", "value": "{{country}}" },
                { "key": "city", "value": "{{city}}" },
                { "key": "check_in", "value": "{{checkIn}}" },
                { "key": "check_out", "value": "{{checkOut}}" },
                { "key": "guests", "value": "{{guests}}" },
                { "key": "currency", "value": "{{currency}}" },
                { "key": "budget", "value": "150000", "disabled": true },
                { "key": "filters", "value": "pool", "disabled": true }
              ]
            },
            "description": "Детали отеля. Те же query, что в Get Hotels (контекст hotels-service): country, city, dates, guests, currency, budget, filters."
          },
          "response": []
        },

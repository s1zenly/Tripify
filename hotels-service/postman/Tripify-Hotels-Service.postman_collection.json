                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Has hotels array', function () {",
                  "        pm.expect(body).to.have.property('hotels');",
                  "        pm.expect(body.hotels).to.be.an('array');",
                  "    });",
                  "",
                  "    if (body.hotels && body.hotels.length > 0) {",
                  "        const savedHotelId = pm.collectionVariables.get('hotelId');",
                  "        if (savedHotelId) {",
                  "            pm.test('List does not duplicate search hotel', function () {",
                  "                const duplicate = body.hotels.find(h => h.hotelId === savedHotelId);",
                  "                pm.expect(duplicate, 'first search hotel must be skipped in list').to.be.undefined;",
                  "            });",
                  "        }",
                  "        console.log('List hotels count:', body.hotels.length);",
                  "    }",
                  "",
                  "    if (body.nextCursor) {",
                  "        pm.collectionVariables.set('cursor', body.nextCursor);",
                  "    } else {",
                  "        pm.collectionVariables.unset('cursor');",
                  "    }",
                  "}"
                ]
              }

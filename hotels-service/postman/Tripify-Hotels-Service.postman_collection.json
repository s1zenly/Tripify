        {
          "name": "Get Hotel Filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Has filters array', function () {",
                  "        pm.expect(body).to.have.property('filters');",
                  "        pm.expect(body.filters).to.be.an('array');",
                  "        pm.expect(body.filters.length).to.be.above(0);",
                  "        pm.expect(body.filters[0]).to.have.property('id');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hotels/filters",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "filters"]
            },
            "description": "Статический каталог фильтров. Id из ответа передавай в `filters` при поиске."
          },
          "response": []
        },

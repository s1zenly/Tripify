                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response has tickets without provider', function () {",
                  "    pm.expect(json.tickets).to.be.an('array');",
                  "    if (json.tickets.length > 0) {",
                  "        pm.expect(json.tickets[0]).to.not.have.property('provider');",
                  "        pm.collectionVariables.set('tid', json.tickets[0].tid);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets?origin_city_code={{originCityCode}}&destination_city_code={{destinationCityCode}}&departure_date={{departureDate}}&return_date={{returnDate}}&adults={{adults}}&children={{children}}&infants={{infants}}&currency={{currency}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "origin_city_code", "value": "{{originCityCode}}" },
                { "key": "destination_city_code", "value": "{{destinationCityCode}}" },
                { "key": "departure_date", "value": "{{departureDate}}" },
                { "key": "return_date", "value": "{{returnDate}}" },

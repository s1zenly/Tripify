    { "key": "xRequestId", "value": "req-tickets-{{$timestamp}}" },
    { "key": "xTicketsRevision", "value": "1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Get Ticket Filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Has filters catalog', function () {",
                  "    pm.expect(json.filters).to.be.an('array');",
                  "    pm.expect(json.filters.length).to.be.above(0);",
                  "    pm.expect(json.filters[0]).to.have.property('id');",
                  "    pm.expect(json.filters[0]).to.not.have.property('count');",
                  "});",
                  "",
                  "if (json.filters && json.filters.length > 0) {",
                  "    pm.collectionVariables.set('filter', json.filters[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/filters",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "filters"]
            },
            "description": "Статический каталог фильтров (без count, без параметров маршрута)."
          },
          "response": []
        },

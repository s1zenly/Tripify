        {
          "name": "Search Tickets (with filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const filterId = pm.collectionVariables.get('filter');",
                  "if (json.tickets && json.tickets.length > 0 && filterId === 'direct') {",
                  "    json.tickets.forEach(function (ticket) {",
                  "        ticket.journeys.forEach(function (j) {",
                  "            pm.expect(j.transfers.is_direct).to.eql(true);",
                  "        });",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets?origin_city_code={{originCityCode}}&destination_city_code={{destinationCityCode}}&departure_date={{departureDate}}&return_date={{returnDate}}&adults={{adults}}&children={{children}}&infants={{infants}}&currency={{currency}}&filters={{filter}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                { "key": "origin_city_code", "value": "{{originCityCode}}" },
                { "key": "destination_city_code", "value": "{{destinationCityCode}}" },
                { "key": "departure_date", "value": "{{departureDate}}" },
                { "key": "return_date", "value": "{{returnDate}}" },
                { "key": "adults", "value": "{{adults}}" },
